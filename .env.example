# Variables de entorno — AEO/GEO Auditor
# Copiá este archivo a `.env.local` y completá los valores.
# `.env.local` está git-ignored; nunca commitees claves reales.
# Todas las llamadas a IA corren del lado del servidor: estas claves NUNCA se exponen al cliente.

# Google AI Studio (Gemini, free tier)
# Obtener en: https://aistudio.google.com → "Get API key"
GEMINI_API_KEY=
# (Opcional) Sobrescribe el modelo de Gemini. Default: gemini-2.0-flash
GEMINI_MODEL=

# OpenRouter (modelos con sufijo ":free")
# Obtener en: https://openrouter.ai → Keys
OPENROUTER_API_KEY=
# (Opcional) Sobrescribe el modelo de OpenRouter. Default: meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODEL=
# (Opcional) Atribución que OpenRouter usa para rankings
OPENROUTER_SITE_URL=
OPENROUTER_SITE_NAME=
